{
  "name": "sde-level-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A four-level study library that renders generated technical notes at four depths.",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "preview": "astro preview",
    "validate": "tsx scripts/validate.ts",
    "new:subject": "tsx scripts/new-subject.ts",
    "new:note": "tsx scripts/new-note.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@shikijs/rehype": "^4.3.1",
    "astro": "^7.1.3",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
